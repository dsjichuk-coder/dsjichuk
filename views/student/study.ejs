<%- include('../partials/header', { title: material.title }) %>
<div class="page-head">
  <div>
    <h1><%= material.title %></h1>
    <p class="subtitle"><%= material.description || '학습 노트와 원문을 읽고 문제를 풀어 보세요.' %><%= assignment.due_date ? ' · 마감 ' + assignment.due_date : '' %></p>
  </div>
  <div class="actions">
    <% if (material.status === 'ready' && questionCount) { %>
      <a class="btn large" href="/student/assignments/<%= assignment.id %>/quiz">문제 풀기 (<%= questionCount %>문항) →</a>
    <% } %>
  </div>
</div>
<% if (assignment.message) { %><div class="alert info">💬 선생님 메시지: <%= assignment.message %></div><% } %>
<% if (material.status !== 'ready') { %><div class="alert warn">자료를 준비 중입니다. 잠시 후 다시 확인해 주세요.</div><% } %>

<div class="card">
  <div class="tabs" role="tablist">
    <button type="button" class="active" data-tab="notes">학습 노트</button>
    <button type="button" data-tab="pdf">원문 PDF</button>
    <% if (attempts.length) { %><button type="button" data-tab="history">내 풀이 기록 (<%= attempts.length %>)</button><% } %>
  </div>
  <div data-panel="notes">
    <%- include('../partials/notes', { notes: material.notes }) %>
  </div>
  <div data-panel="pdf" hidden>
    <p class="small muted">PDF가 보이지 않으면 <a href="/student/assignments/<%= assignment.id %>/pdf" target="_blank" rel="noopener">새 창에서 열기</a>를 눌러 주세요.</p>
    <iframe class="pdf-frame" data-src="/student/assignments/<%= assignment.id %>/pdf" title="원문 PDF"></iframe>
  </div>
  <% if (attempts.length) { %>
  <div data-panel="history" hidden>
    <table>
      <thead><tr><th>회차</th><th>제출 시각</th><th class="num">점수</th><th></th></tr></thead>
      <tbody>
      <% attempts.forEach((t, i) => { %>
        <tr>
          <td><%= attempts.length - i %>회차</td>
          <td><%= fmtDate(t.submitted_at) %></td>
          <td class="num"><%= t.score %>/<%= t.total %> (<%= percent(t.score, t.total) %>점)</td>
          <td class="right"><a class="btn small secondary" href="/student/attempts/<%= t.id %>">결과·해설</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<script>
  document.querySelectorAll('[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((b) => b.classList.toggle('active', b === btn));
      document.querySelectorAll('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== btn.dataset.tab; });
      const frame = document.querySelector(`[data-panel="${btn.dataset.tab}"] iframe[data-src]`);
      if (frame && !frame.src) frame.src = frame.dataset.src; // PDF는 탭을 열 때 불러온다
    });
  });
</script>
<%- include('../partials/footer') %>
