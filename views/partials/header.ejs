<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>스터디 PDF</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">📘 스터디 PDF</a>
    <% if (user) { %>
      <nav class="nav">
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">대시보드</a>
          <a href="/admin/materials" class="<%= path.startsWith('/admin/materials') ? 'active' : '' %>">학습자료</a>
          <a href="/admin/students" class="<%= path.startsWith('/admin/students') ? 'active' : '' %>">학생</a>
        <% } else { %>
          <a href="/student" class="<%= path.startsWith('/student') ? 'active' : '' %>">내 학습</a>
        <% } %>
      </nav>
      <div class="userbox">
        <span class="name"><%= user.name %> (<%= user.role === 'admin' ? '관리자' : '학생' %>)</span>
        <a href="/account">내 계정</a>
        <form method="post" action="/logout"><button class="linkish">로그아웃</button></form>
      </div>
    <% } %>
  </div>
</header>
<main>
<% if (flash) { %><div class="alert ok"><%= flash %></div><% } %>
<% if (flashError) { %><div class="alert bad"><%= flashError %></div><% } %>
