<%- include('../partials/header', { title: '학생 관리' }) %>
<div class="page-head"><div><h1>학생</h1><p class="subtitle">학생 계정을 만들고, 학생별 학습 현황을 확인합니다.</p></div></div>
<div class="grid grid-2" style="grid-template-columns: minmax(0,2fr) minmax(280px,1fr); align-items:start">
  <div class="card">
    <h2>학생 목록</h2>
    <div class="table-wrap">
    <table>
      <thead><tr><th>이름</th><th>아이디</th><th class="num">발송</th><th class="num">완료</th><th class="num">평균 점수</th></tr></thead>
      <tbody>
      <% if (!students.length) { %><tr><td colspan="5" class="empty">등록된 학생이 없습니다. 오른쪽에서 학생을 추가하세요.</td></tr><% } %>
      <% students.forEach((s) => { %>
        <tr>
          <td><a href="/admin/students/<%= s.id %>"><b><%= s.name %></b></a></td>
          <td class="muted"><%= s.username %></td>
          <td class="num"><%= s.assigned %></td>
          <td class="num"><%= s.completed %></td>
          <td class="num"><%= s.avg_ratio === null ? '-' : Math.round(s.avg_ratio * 100) + '점' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  </div>
  <div class="card">
    <h2>학생 추가</h2>
    <% if (error) { %><div class="alert bad"><%= error %></div><% } %>
    <form method="post" action="/admin/students">
      <div class="field"><label>이름</label><input type="text" name="name" value="<%= form.name || '' %>" required></div>
      <div class="field"><label>아이디 <span class="hint">(로그인용, 영문/숫자)</span></label><input type="text" name="username" value="<%= form.username || '' %>" required pattern="[A-Za-z0-9_.\-]{3,30}"></div>
      <div class="field"><label>초기 비밀번호 <span class="hint">(6자 이상)</span></label><input type="text" name="password" required minlength="6"></div>
      <button class="btn" style="width:100%">추가</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
