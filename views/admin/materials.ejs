<%- include('../partials/header', { title: '학습자료' }) %>
<div class="page-head"><div><h1>학습자료</h1><p class="subtitle">PDF를 올리면 <%= aiEnabled ? 'AI가 학습 노트와 문제·해설을 자동으로 만듭니다.' : '학습 노트와 문항을 작성해 학생에게 발송할 수 있습니다.' %></p></div></div>

<div class="card">
  <h2>새 학습자료 올리기</h2>
  <form method="post" action="/admin/materials" enctype="multipart/form-data">
    <div class="row">
      <div class="field"><label>PDF 파일 <span class="hint">(최대 32MB)</span></label><input type="file" name="pdf" accept="application/pdf,.pdf" required></div>
      <div class="field"><label>제목 <span class="hint">(비우면 자동)</span></label><input type="text" name="title"></div>
    </div>
    <div class="field"><label>설명 <span class="hint">(선택, 학생에게 표시)</span></label><input type="text" name="description"></div>
    <% if (aiEnabled) { %>
      <div class="row">
        <div class="field" style="flex:0 0 160px"><label>문항 수</label><input type="number" name="question_count" value="10" min="1" max="30"></div>
        <div class="field"><label>AI 출제 요청사항 <span class="hint">(선택, 예: 3장 위주로, 난이도 높게)</span></label><input type="text" name="instructions"></div>
      </div>
    <% } %>
    <button class="btn"><%= aiEnabled ? '업로드하고 AI 생성' : '업로드' %></button>
  </form>
</div>

<div class="card">
  <h2>학습자료 목록</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>제목</th><th>상태</th><th class="num">문항</th><th class="num">발송</th><th class="num">풀이 완료</th><th>등록일</th></tr></thead>
    <tbody>
    <% if (!materials.length) { %><tr><td colspan="6" class="empty">등록된 학습자료가 없습니다.</td></tr><% } %>
    <% materials.forEach((m) => { %>
      <tr>
        <td><a href="/admin/materials/<%= m.id %>"><b><%= m.title %></b></a><div class="muted small"><%= m.original_name %></div></td>
        <td><span class="badge <%= m.status %>"><%= STATUS_LABELS[m.status] %></span></td>
        <td class="num"><%= m.question_count %></td>
        <td class="num"><%= m.assigned %></td>
        <td class="num"><%= m.completed %></td>
        <td><%= fmtDate(m.created_at) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
